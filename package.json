{
  "name": "alcyo-shorts",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @alcyo/desktop dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:e2e": "turbo run test:e2e",
    "package:mac": "pnpm --filter @alcyo/desktop package:mac",
    "package:win": "pnpm --filter @alcyo/desktop package:win",
    "fetch-binaries": "node scripts/fetch-binaries.ts",
    "plan:validate": "node scripts/validate-plan.ts",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "format": "prettier --write .",
    "check:media": "node scripts/check-no-media.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
